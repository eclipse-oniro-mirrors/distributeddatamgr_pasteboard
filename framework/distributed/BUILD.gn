import("//build/ohos.gni")
import("//foundation/distributeddatamgr/pasteboard/pasteboard.gni")

group("build_module") {
  deps = []
  if (pasteboard_distributed_clip_enabled) {
    deps += [
      ":distributed_clip",
      "conf:build_module",
    ]
  }
}

config("distributed_clip_config") {
  include_dirs = [ "include" ]
}

if (pasteboard_distributed_clip_enabled) {
  ohos_shared_library("distributed_clip") {
    sources = [
      "src/clip_factory.cpp",
      "src/distributed_clip.cpp",
      "src/clip_para.cpp",
      "src/store.cpp",
      "src/store_observer.cpp",
      "src/sync_callback.cpp",
      "src/all_connect_adapter.cpp",
      "src/broadcast_manager.cpp",
      "src/broadcast_manager_listener.cpp",
      "src/system_ability_listener.cpp",
      "src/utils.cpp",
    ]
    include_dirs = [
      "include",
      "${pasteboard_framework_path}/include",
      "${pasteboard_utils_path}/native/include",
      "${pasteboard_service_path}/dfx/src",
      "${pasteboard_root_path}/adapter/include",
    ]
    deps = [ "${pasteboard_framework_path}:pasteboard_framework" ]
    public_configs = [ ":distributed_clip_config" ]
    external_deps = [
      "c_utils:utils",
      "cJSON:cjson",
      "device_manager:devicemanagersdk",
      "dsoftbus:softbus_client",
      "eventhandler:libeventhandler",
      "ffrt:libffrt",
      "hilog:libhilog",
      "hisysevent:libhisysevent",
      "hitrace:hitrace_meter",
      "ipc:ipc_core",
      "kv_store:distributeddata_inner",
      "os_account:libaccountkits",
      "os_account:os_account_innerkits",
      "samgr:samgr_proxy",
      "wifi:wifi_sdk",
      "CollaborationFwk:cfwk_allconnect_client",
      "CollaborationFwk:collaborationfwk_client",
      "dsoftbus_service_ext:dsoftbus_client_plugin",
    ]
    defines = [ "PB_DISTRIBUTED_CLIP_ENABLE" ]
    subsystem_name = "distributeddatamgr"
    part_name = "pasteboard"
    cflags = [
      "-fvisibility=hidden",
      "-fno-access-control",
    ]
  }
}
